{
  "name": "dsh-plugin-dictate",
  "description": "Live speech-to-text dictation into the dsh web composer via OpenRouter STT",
  "version": "0.1.0",
  "author": {
    "name": "navneetset",
    "url": "https://github.com/navneetset"
  },
  "homepage": "https://github.com/navneetset/dsh-dictate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navneetset/dsh-dictate.git"
  },
  "bugs": {
    "url": "https://github.com/navneetset/dsh-dictate/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "speech-to-text",
    "dictation",
    "openrouter"
  ],
  "license": "MIT"
}
